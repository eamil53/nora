rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection and subcollections
    match /users/{userId} {
      allow read, write: if true;
      match /notification_history/{historyId} {
        allow read, write: if true;
      }
    }

    // Notification campaign performance metrics (opens, conversions, sends)
    match /notification_campaigns/{campaignId} {
      allow read, write: if true;
    }

    // Independent conversion records
    match /conversions/{conversionId} {
      allow read, write: if true;
    }

    // Server-managed blocked sites table/collection
    match /blocked_sites/{siteId} {
      allow read, write: if true;
    }
  }
}
